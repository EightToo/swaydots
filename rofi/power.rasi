configuration {
    modi: "drun";
    font: "JetBrains Mono 10";
}

@theme "/dev/null"

* {
    bg: #121212;
    fg: #E8E3E3;
    muted: #777070;
    accent: #958798;

    background-color: @bg;
    text-color: @fg;
}

window {
    location: center;
    anchor: center;

    width: 300px;
    height: 210px;

    x-offset: -20px;
    y-offset: 42px;


    background-color: @bg;
    padding: 8px;

    children: [box];
}

box {
    padding: 0.75em;
    spacing: 0.5em;
    children: [listview];
}

listview {
    lines: 4;
    fixed-height: true;
    spacing: 3px;
    background-color: transparent;
}

element {
    padding: 9px 12px;
    border-radius: 5px;
    background-color: transparent;
    text-color: @muted;
}

element selected {
    background-color: #29232e;
    text-color: @accent;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}
